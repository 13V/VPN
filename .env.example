# Only use a separately funded test wallet. Never commit real values.
# Blink currently cannot enforce the required per-payment fee ceiling.
BLINK_API_KEY=
BLINK_WALLET_ID=
# Defaults outside the repository and OneDrive, under LOCALAPPDATA on Windows.
# VPN_STATE_DIR=

# Holder portal: defaults to local-only demo; preview disables demo sign-in.
# VPN_PORTAL_MODE=demo
# VPN_ORIGIN=http://127.0.0.1:4173
# HOST=127.0.0.1
# PORT=4173
# VPN_PORTAL_STATE_DIR=/private/local/portal-directory
# VPN_ALLOWANCES_FILE=/private/local/funded-weekly-snapshot.json

# Optional private live pilot using prepaid VPNresellers credit. Keep the API token
# and signing key in server/operator environments only, never in browser code.
# VPN_RESELLERS_API_TOKEN=
# VPN_PILOT_SIGNING_KEY=  # 32 random bytes encoded as 64 hex characters
# VPN_PILOT_ENABLED=1     # explicit server-side switch after paid testing
# VPN_PILOT_STATE_DIR=    # private local directory outside the repository/cloud sync
# VPN_PILOT_MAX_ACCOUNTS=1

# Vercel only: connect a PRIVATE Blob store; credentials belong in Vercel environment settings.
# BLOB_READ_WRITE_TOKEN=
# NODEJS_HELPERS=0
