# Only use a separately funded test wallet. Never commit real values.
# Blink currently cannot enforce the required per-payment fee ceiling.
BLINK_API_KEY=
BLINK_WALLET_ID=
# Defaults outside the repository and OneDrive, under LOCALAPPDATA on Windows.
# VPN_STATE_DIR=

# Holder portal: defaults to local-only demo; preview disables demo sign-in.
# VPN_PORTAL_MODE=demo
# VPN_ORIGIN=http://127.0.0.1:4173
# HOST=127.0.0.1
# PORT=4173
# VPN_PORTAL_STATE_DIR=/private/local/portal-directory
# VPN_ALLOWANCES_FILE=/private/local/funded-weekly-snapshot.json
